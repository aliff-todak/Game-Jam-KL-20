"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BuiltinCommonInstructions::CompareNumbers"},"parameters":["DistanceBetweenPositions(Object.X(), Object.Y(), LastX, LastY)",">","IdleDistanceTolerance"]}],"actions":[{"type":{"value":"SetBooleanVariable"},"parameters":["IsFarFromLastPosition","True",""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["IdleTime","+","LayerTimeScale(Object.Layer())*TimeDelta()"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BooleanVariable"},"parameters":["IsFarFromLastPosition","True",""]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["LastX","=","Object.X()"]},{"type":{"value":"SetNumberVariable"},"parameters":["LastY","=","Object.Y()"]},{"type":{"value":"SetNumberVariable"},"parameters":["IdleTime","=","0"]}]}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"IdleTracker::IdleTracker","type":"behavior"}],"objectGroups":[]},{"fullName":"","functionType":"Action","name":"onCreated","sentence":"","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["LastX","=","Object.X()"]},{"type":{"value":"SetNumberVariable"},"parameters":["LastY","=","Object.Y()"]}]}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"IdleTracker::IdleTracker","type":"behavior"}],"objectGroups":[]},{"description":"Check if the object has just moved from its last position (using the tolerance configured in the behavior).","fullName":"Has just moved from last position","functionType":"Condition","name":"HasMovedFromLastPosition","sentence":"_PARAM0_ has moved from its last position","events":[{"type":"BuiltinCommonInstructions::Standard","co